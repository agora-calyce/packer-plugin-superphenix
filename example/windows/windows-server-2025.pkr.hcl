# Windows Server 2025 from an ISO, WinRM, then export.
# Superphenix imports ISOs from a URL it can reach (not from the runner on a private IP): the answer-file ISO
# is therefore static and hosted (make-answer-iso.sh). It holds the WinRM bootstrap, so the build VM never needs
# to reach the runner, and the same ISO serves any runner.
# win_username / win_password must match the ISO's build account (make-answer-iso.sh WIN_USERNAME / PASSWORD,
# defaults below). The plugin replaces that account with final_username at the end of the build.

packer {
  required_plugins {
    superphenix = {
      version = ">= 0.1.0"
      source  = "github.com/agora-calyce/superphenix"
    }
  }
}

variable "token" {
  type      = string
  sensitive = true
}
variable "win_password" {
  type      = string
  sensitive = true
  default   = "Packer-build-1" # throwaway: only valid during the build
}
variable "final_username" { default = "ops" }
variable "final_password" {
  type      = string
  sensitive = true
}
variable "answer_iso_url" {
  type        = string
  description = "URL of the ISO produced by answer-iso/make-answer-iso.sh"
}
variable "iso_url" {
  type        = string
  description = "URL of a Windows Server 2025 ISO that Superphenix can download"
}
variable "api_url" { type = string }
variable "org_id" { type = string }
variable "az" { type = string }
variable "project_id" { type = string }
variable "subnet_eid" { type = string }
variable "storage_class" { default = "block-standard" }
# Build account created by the answer file (make-answer-iso.sh WIN_USERNAME).
variable "win_username" { default = "packer" }

source "superphenix" "win2025" {
  api_url       = var.api_url
  org_id        = var.org_id
  az            = var.az
  project_id    = var.project_id
  token         = var.token
  subnet_eid    = var.subnet_eid
  storage_class = var.storage_class

  vm_type       = "windows.2k25" # sets EFI, Secure Boot and TPM
  disk_bus      = "sata"         # no virtio driver during installation
  iso_url       = var.iso_url
  iso_disk_size = "8Gi"
  cpu           = 4
  memory        = "8Gi"
  disk_size     = "50Gi"

  # Static answer-file ISO, generated by answer-iso/make-answer-iso.sh and hosted once (it carries the WinRM bootstrap).
  cd_url = var.answer_iso_url

  # "Press any key to boot from CD": timing varies, so repeat. Extra key presses land on the
  # Windows Boot Manager menu and pause its countdown: the final <enter> launches "Windows Setup".
  boot_wait    = "5s"
  boot_command = ["<spacebar><wait3><spacebar><wait3><spacebar><wait3><spacebar><wait3><enter>"]

  communicator   = "winrm"
  winrm_username = var.win_username
  winrm_password = var.win_password
  # Created after the provisioners; the build account is deleted at the first boot of the image.
  winrm_final_username = var.final_username
  winrm_final_password = var.final_password
  winrm_use_ssl  = false
  winrm_insecure = true
  winrm_timeout  = "2h" # the install takes about 30 min, wide margin
}

build {
  sources = ["source.superphenix.win2025"]

  provisioner "powershell" {
    elevated_user     = var.win_username
    elevated_password = var.win_password
    inline = [
      "$sizeMax = (Get-PartitionSupportedSize -DriveLetter C).SizeMax",
      "Resize-Partition -DriveLetter C -Size $sizeMax"
    ]
  }

  # Fallback EFI path: NVRAM is not always preserved, so the BootOrder is lost on reboot.
  provisioner "powershell" {
    elevated_user     = var.win_username
    elevated_password = var.win_password
    inline = [
      "$esp = Get-Partition | Where-Object { $_.GptType -eq '{c12a7328-f81f-11d2-ba4b-00a0c93ec93b}' }",
      "$esp | Add-PartitionAccessPath -AccessPath 'S:'",
      "New-Item -ItemType Directory -Force -Path 'S:\\EFI\\Boot' | Out-Null",
      "Copy-Item 'C:\\Windows\\Boot\\EFI\\bootmgfw.efi' 'S:\\EFI\\Boot\\bootx64.efi' -Force",
      "$esp | Remove-PartitionAccessPath -AccessPath 'S:'"
    ]
  }

  provisioner "powershell" {
    elevated_user     = var.win_username
    elevated_password = var.win_password
    execution_policy  = "remotesigned"
    scripts = [
      "${path.root}/scripts/windows-preparation.ps1",
      "${path.root}/scripts/windows-cleanup.ps1",
    ]
  }

  # qcow2 export: a helper VM converts the disk and sends it to the runner.
  # The Windows disk holds an EFI system: boot the qcow2 with UEFI firmware.
  post-processor "superphenix-export" {
    api_url          = var.api_url
    org_id           = var.org_id
    az               = var.az
    project_id       = var.project_id
    token            = var.token
    subnet_eid       = var.subnet_eid
    storage_class    = var.storage_class
    helper_image_url = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
    helper_disk_size = "40Gi" # must hold the converted qcow2
    output_path      = "output/windows-server-2025.qcow2"
  }
}
